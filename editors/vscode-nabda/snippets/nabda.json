{
  "Nabda Main Function": {
    "prefix": "main",
    "body": [
      "fn main():",
      "    ${1:io::println(\"Nabda Ready\")}"
    ],
    "description": "Entry point function in Nabda"
  },
  "Hardware Power & Voltage Control": {
    "prefix": "power-rail",
    "body": [
      "power::set_voltage(\"${1|VCORE,VDDQ,GPU_CORE,SOC_IO|}\", ${2:1.15V})",
      "cpu::set_freq(${3:0}, ${4:4.2GHz})",
      "hardware::fan_set_speed(${5:0}, ${6:75})"
    ],
    "description": "Configure voltage rail, CPU clock frequency, and fan speed"
  },
  "OS Kernel Boot Section": {
    "prefix": "kernel-boot",
    "body": [
      "unsafe_hardware:",
      "    kernel::init_gdt()",
      "    kernel::init_idt()",
      "    kernel::init_paging()",
      "    let vga = memory::map_mmio(0xB8000, 4096)",
      "    memory::write_u16(vga, 0x0F4E)",
      "kernel::log(\"BOOT\", \"${1:Kernel initialized}\")"
    ],
    "description": "Initialize GDT, IDT, Paging, and VGA MMIO in kernel mode"
  },
  "Cybersecurity Hardening": {
    "prefix": "sec-harden",
    "body": [
      "security::enable_aslr()",
      "security::enable_dep_nx()",
      "security::enable_stack_canary()",
      "let hash = security::hash_sha256(${1:\"payload\"})",
      "let pcr = security::tpm_attest(0, hash)"
    ],
    "description": "Enable ASLR, DEP/NX, stack canaries, and TPM PCR attestation"
  },
  "External C/Rust FFI Library": {
    "prefix": "ffi-extern",
    "body": [
      "@link(\"${1:ssl}\")",
      "extern \"C\" fn ${2:c_function}(${3:arg: str}) -> ${4:int}"
    ],
    "description": "Bind an open-source C/Rust shared library function"
  }
}
