{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nabda",
  "scopeName": "source.nabda",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#units" },
    { "include": "#numbers" },
    { "include": "#namespaces" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.nabda", "match": "#.*$" },
        { "name": "comment.line.double-slash.nabda", "match": "//.*$" },
        { "name": "comment.block.nabda", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nabda",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.nabda", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.nabda",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.nabda", "match": "\\\\." }]
        }
      ]
    },
    "attributes": {
      "patterns": [
        { "name": "meta.attribute.nabda", "match": "@[a-zA-Z_][a-zA-Z0-9_]*" }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "constant.numeric.unit.nabda",
          "match": "\\b[0-9]+(\\.[0-9]+)?(mV|V|GHz|MHz|kHz|Hz|ns|us|ms|s)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.nabda", "match": "\\b0[xX][0-9a-fA-F_]+\\b" },
        { "name": "constant.numeric.binary.nabda", "match": "\\b0[bB][01_]+\\b" },
        { "name": "constant.numeric.float.nabda", "match": "\\b[0-9][0-9_]*\\.[0-9_]+\\b" },
        { "name": "constant.numeric.integer.nabda", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "match": "\\b(memory|hardware|power|cpu|gpu|display|time|kernel|security|io|fs|net|ffi|math)::",
          "captures": {
            "1": { "name": "entity.name.namespace.nabda support.class.nabda" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nabda",
          "match": "\\b(if|elif|else|for|in|while|loop|match|case|return|break|continue|unsafe_hardware)\\b"
        },
        {
          "name": "keyword.declaration.nabda",
          "match": "\\b(fn|let|var|struct|enum|import|use|extern|const|as)\\b"
        },
        {
          "name": "keyword.operator.logical.nabda",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.nabda",
          "match": "\\b(true|false|none|None)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.nabda",
          "match": "\\b(int|i64|i32|u8|u16|u32|u64|float|f64|f32|bool|str|bytes|addr|volt|freq|time|list|map|void)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.nabda",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nabda",
          "match": "(->|=>|::|\\.\\.=?|==|!=|<=|>=|<<|>>|\\+=|-=|\\*=|/=|[+\\-*/%<>=&|^~])"
        }
      ]
    }
  }
}
