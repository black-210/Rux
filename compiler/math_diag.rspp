// rust++ Self-Hosted Mathematical Error Diagnosis & Recovery Engine

fn rspp_min2(a: int, b: int) -> int:
    if a < b:
        return a
    return b

fn rspp_min3(a: int, b: int, c: int) -> int:
    return rspp_min2(a, rspp_min2(b, c))

// Optimal String Alignment (Damerau-Levenshtein) edit distance
fn dl_distance(a: str, b: str) -> int:
    let m = a.len()
    let n = b.len()
    if m == 0:
        return n
    if n == 0:
        return m
    let cols = n + 1
    var dp = []
    var r = 0
    while r <= m:
        var c = 0
        while c <= n:
            if r == 0:
                dp.push(c)
            elif c == 0:
                dp.push(r)
            else:
                dp.push(0)
            c += 1
        r += 1
    var i = 1
    while i <= m:
        var j = 1
        while j <= n:
            let ca = a.char_code_at(i - 1)
            let cb = b.char_code_at(j - 1)
            var cost = 1
            if ca == cb:
                cost = 0
            let v_del = dp[(i - 1) * cols + j] + 1
            let v_ins = dp[i * cols + (j - 1)] + 1
            let v_sub = dp[(i - 1) * cols + (j - 1)] + cost
            var best = rspp_min3(v_del, v_ins, v_sub)
            if i > 1 and j > 1:
                let ca2 = a.char_code_at(i - 2)
                let cb2 = b.char_code_at(j - 2)
                if ca == cb2 and ca2 == cb:
                    let v_trans = dp[(i - 2) * cols + (j - 2)] + 1
                    if v_trans < best:
                        best = v_trans
            dp[i * cols + j] = best
            j += 1
        i += 1
    return dp[m * cols + n]

// Character bigram cosine similarity in [0.0, 1.0]
fn bigram_cosine(a: str, b: str) -> float:
    let pa = "^" + a + "$"
    let pb = "^" + b + "$"
    var ma = {}
    var mb = {}
    var i = 0
    while i + 1 < pa.len():
        let bg = pa.slice(i, i + 2)
        let prev = ma.get(bg, 0)
        ma.set(bg, prev + 1)
        i += 1
    var j = 0
    while j + 1 < pb.len():
        let bg = pb.slice(j, j + 2)
        let prev = mb.get(bg, 0)
        mb.set(bg, prev + 1)
        j += 1
    var dot = 0.0
    var norm_a = 0.0
    var norm_b = 0.0
    for k in ma.keys():
        let va = ma.get(k, 0) as float
        norm_a = norm_a + va * va
        if mb.has(k):
            let vb = mb.get(k, 0) as float
            dot = dot + va * vb
    for k in mb.keys():
        let vb = mb.get(k, 0) as float
        norm_b = norm_b + vb * vb
    if norm_a <= 0.0 or norm_b <= 0.0:
        return 0.0
    return dot / (math::sqrt(norm_a) * math::sqrt(norm_b))

// Bayesian posterior ranking combining edit distance and bigram cosine similarity
fn bayesian_best_candidate(needle: str, candidates: list) -> map:
    var best_name = ""
    var best_score = -1.0
    var best_dist = 999
    var best_cos = 0.0
    var sum_w = 0.0
    for cand in candidates:
        let d = dl_distance(needle, cand)
        let cos = bigram_cosine(needle, cand)
        var max_len = needle.len()
        if cand.len() > max_len:
            max_len = cand.len()
        if max_len < 1:
            max_len = 1
        var dl_s = 1.0 - (d as float) / (max_len as float)
        if dl_s < 0.0:
            dl_s = 0.0
        let w = math::exp(3.5 * dl_s + 2.5 * cos)
        sum_w = sum_w + w
        if w > best_score:
            best_score = w
            best_name = cand
            best_dist = d
            best_cos = cos
    var prob = 0.0
    if sum_w > 0.0 and best_score > 0.0:
        prob = best_score / sum_w
    return {"name": best_name, "dist": best_dist, "cosine": best_cos, "prob": prob}

fn format_diag(code: str, line: int, msg_en: str, msg_ar: str, why: str, fix: str, math_note: str) -> str:
    return f"[{code}] line {line}: {msg_en}\n    {msg_ar}\n  Why: {why}\n  Math: {math_note}\n  Fix: {fix}"
