# Example 6: Open-Source C / Rust Library FFI Interop
# Use `nabda import-c header.h libname` to auto-generate bindings from any open-source project!

@link("m")
extern "C" fn sqrt(x: float) -> float

@link("c")
extern "C" fn puts(msg: str) -> int

fn main():
    io::println("FFI sizeof(u64) = " + ffi::sizeof("u64"))
    let lib = ffi::load_lib("libm.so.6")
    io::println("Loaded external shared library handle: " + lib)
